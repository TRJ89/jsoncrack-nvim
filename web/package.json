{
  "name": "jsoncrack-nvim-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.9",
  "engines": {
    "node": "22.23.4",
    "npm": "10.9.9"
  },
  "scripts": {
    "build:renderer-test": "vite build --mode renderer-test",
    "test:renderer": "playwright test tests/renderer.spec.ts",
    "test:e2e": "playwright test --config playwright.config.ts tests/e2e/preview.spec.ts",
    "test:performance": "JSONCRACK_CHROMIUM_OZONE=x11 playwright test --config playwright.config.ts tests/e2e/performance.spec.ts --headed",
    "test": "vitest run",
    "test:licenses": "node --test scripts/licenses.test.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:python": "pyright --project ../pyrightconfig.json",
    "build": "vite build && node scripts/build-manifest.mjs && node scripts/licenses.mjs"
  },
  "dependencies": {
    "jsonc-parser": "3.3.1",
    "jsoncrack-react": "1.0.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.3",
    "pyright": "1.1.414",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
