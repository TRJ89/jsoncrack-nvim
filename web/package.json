{
  "name": "jsoncrack-nvim-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.3",
  "engines": {
    "node": "22.19.0",
    "npm": "10.9.3"
  },
  "scripts": {
    "build:renderer-test": "vite build --mode renderer-test",
    "test:renderer": "playwright test tests/renderer.spec.ts",
    "test:e2e": "playwright test --config playwright.config.ts tests/e2e/preview.spec.ts",
    "test:performance": "JSONCRACK_CHROMIUM_OZONE=x11 playwright test --config playwright.config.ts tests/e2e/performance.spec.ts --headed",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "vite build && node scripts/build-manifest.mjs"
  },
  "dependencies": {
    "jsonc-parser": "3.3.1",
    "jsoncrack-react": "1.0.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@types/node": "24.10.1",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "27.1.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
